# ---------------------------------------------------------------------------
# Frontend (Vite). Sólo valores PÚBLICOS: la anon key es segura gracias a RLS.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=true
# URL de producción del webhook de n8n Cloud, p. ej. https://<tu-instancia>.app.n8n.cloud/webhook/student-request-demo
VITE_N8N_DEMO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Server / scripts / n8n only — NUNCA exponer en el frontend ni commitear
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: sólo para evaluar el prompt desde scripts locales. En el MVP la IA corre
# dentro de n8n Cloud con la credencial "n8n free OpenAI API credits" del trial.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_LOW_CONFIDENCE_THRESHOLD=0.70
DEMO_MODE=true
# Contraseña de los usuarios demo sintéticos creados por `npm run seed:users`
DEMO_USER_PASSWORD=Demo-MVP-2026!
# Webhook usado por `npm run eval:n8n` (mismo valor que VITE_N8N_DEMO_WEBHOOK_URL)
N8N_DEMO_WEBHOOK_URL=
# Usados por `npm run build:n8n` para generar los workflows con sus URLs
N8N_SUPABASE_URL=
N8N_WEBHOOK_BASE=

# Optional
OUTLOOK_ACCOUNT_LABEL=
APP_TIMEZONE=America/Bogota
